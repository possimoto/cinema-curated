# Public site URL (production deployment URL or custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI — optional. Without this, source-grounded keyword search still works.
OPENAI_API_KEY=
OPENAI_RECOMMEND_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# TMDB — optional, but required for poster/director/actor/genre enrichment.
TMDB_READ_TOKEN=

# Supabase — optional for local preview, required for persistent admin edits/vector DB in production.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin — required for /admin write operations. Generate a long random value.
ADMIN_SECRET=
